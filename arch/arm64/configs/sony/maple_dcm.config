CONFIG_MACH_SONY_MAPLE_DCM=y
CONFIG_MMTUNER_MN8855x=y
CONFIG_NFC_CARILLON=y
CONFIG_STAGING=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_SECURITY=y
CONFIG_EROFS_FS_ZIP=y
# CONFIG_IPA is not set

# Compiler: -Os instead of -O2 (5-10%)
CONFIG_CC_OPTIMIZE_FOR_SIZE=y

# Disable debug info and unused symbols
# CONFIG_DEBUG_INFO is not set
# CONFIG_KALLSYMS_ALL is not set
# CONFIG_DYNAMIC_DEBUG is not set
# CONFIG_SLUB_DEBUG is not set
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_DEBUG_PREEMPT is not set
# CONFIG_PM_DEBUG is not set
# CONFIG_DEBUG_FS is not set

# Disable unused input and media drivers
# CONFIG_HID_LOGITECH is not set
# CONFIG_HID_PANTHERLORD is not set
# CONFIG_MEDIA_USB_SUPPORT is not set

# Disable unused filesystems and netfilter bits
# CONFIG_NFS_FS is not set
# CONFIG_CIFS is not set
# CONFIG_NTFS_FS is not set
# CONFIG_JFFS2_FS is not set
